# Shared design notes (Figma-like). Used by Vite at build/dev time.
# Copy to `.env.local` and fill in. Never commit real tokens.

# Repo that stores design-notes.json (usually this same repo)
VITE_NOTES_GITHUB_OWNER=delt1330
VITE_NOTES_GITHUB_REPO=altenar
VITE_NOTES_GITHUB_BRANCH=main
VITE_NOTES_GITHUB_PATH=design-notes.json

# Fine-grained PAT with Contents: Read and write on that repo only.
# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
# Repository access: Only select repositories → altenar
# Permissions → Repository → Contents: Read and write (not Read-only)
# Also set the same value as Actions secret NOTES_GITHUB_TOKEN for Pages deploy.
VITE_NOTES_GITHUB_TOKEN=

# The Noun Project API (OAuth 1.0a). Server-only — used by Vite proxy `/api/noun/*`.
# Do NOT prefix with VITE_ (secret must not ship to the browser bundle).
# https://thenounproject.com/developers/apps/
NOUN_PROJECT_KEY=
NOUN_PROJECT_SECRET=
